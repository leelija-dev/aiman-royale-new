# Local Docker defaults only. Set a unique secret before running.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
POSTGRES_DB=aiman_royale
POSTGRES_USER=aiman
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
DATABASE_URL=postgresql://aiman:replace-with-a-strong-local-database-password@db:5432/aiman_royale
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000
INTERNAL_API_URL=http://backend:8000
INTERNAL_REQUEST_SCHEME=http
NEXT_PUBLIC_SITE_URL=http://localhost:8080
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_GRAPH_VERSION=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Aiman Royale <noreply@your-domain.example>
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=ap-south-1
MEDIA_CDN_DOMAIN=
